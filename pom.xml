<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pro.datawiki.igaming</groupId>
    <artifactId>igaming-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>iGaming Monorepo</name>
    <description>Parent reactor POM for all iGaming services</description>

    <!-- ============================================================ -->
    <!--  Module build order: libraries first, then services          -->
    <!-- ============================================================ -->
    <modules>
        <!-- Application Services -->
        <module>antigravity-overlay-backend</module>
        <module>igaming-infra-operator</module>
        <module>igaming-notifications-service</module>

        <!-- Match Result Capture Services -->
        <module>igaming-capture-sofascore</module>
        <module>igaming-capture-liveresult</module>

        <!-- Source Crawlers -->
        <module>igaming-source-pinnacle</module>
        <module>igaming-source-betb2b</module>
        <module>igaming-source-sbobet</module>
        <module>igaming-source-dafabet</module>
        <module>igaming-source-digitain</module>
        <module>igaming-source-unibet</module>
        <module>igaming-source-draftkings</module>
        <module>igaming-source-bet365</module>
        <module>igaming-source-betfair</module>
        <module>igaming-source-bwin</module>
        <module>igaming-source-888sport</module>
        <module>igaming-source-betsson</module>
        <module>igaming-source-fanduel</module>
        <module>igaming-source-betmgm</module>
        <module>igaming-source-caesars</module>
        <module>igaming-source-bovada</module>
        <module>igaming-source-smarkets</module>
        <module>igaming-source-stoiximan</module>
        <module>igaming-source-atg</module>
        <module>igaming-source-wplay</module>

        <!-- Analytics & Other -->
        <module>igaming-analytics-service</module>
        <module>igaming-k8s-workload-manager</module>
        <module>igaming-syndicate-bots</module>
    </modules>

    <!-- ============================================================ -->
    <!--  Shared properties (available to all modules via inheritance) -->
    <!-- ============================================================ -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <lombok.version>1.18.46</lombok.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jib-maven-plugin.version>3.4.1</jib-maven-plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
