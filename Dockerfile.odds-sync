# ---------- build igaming-dto (shared dependency) ----------
FROM ghcr.io/datawikipro/igaming-build-base:latest AS build-dto
WORKDIR /dto
COPY igaming-dto/pom.xml .
COPY igaming-dto/src ./src
RUN mvn install -DskipTests -B

# ---------- build application ----------
FROM ghcr.io/datawikipro/igaming-build-base:latest AS build
COPY --from=build-dto /root/.m2/repository/pro/datawiki /tmp/dto-repo/pro/datawiki
WORKDIR /app

# Copy root pom and all module poms
COPY igaming-aggregator/pom.xml ./
COPY igaming-aggregator/aggregator-domain/pom.xml     ./aggregator-domain/
COPY igaming-aggregator/aggregator-odds-sync/pom.xml  ./aggregator-odds-sync/

# Pre-fetch dependencies (domain + odds-sync only)
RUN --mount=type=cache,target=/root/.m2 \
    mkdir -p /root/.m2/repository/pro/datawiki && \
    cp -rf /tmp/dto-repo/pro/datawiki/* /root/.m2/repository/pro/datawiki/ && \
    mvn dependency:go-offline -pl aggregator-domain,aggregator-odds-sync -B || true

# Copy sources
COPY igaming-aggregator/aggregator-domain/src    ./aggregator-domain/src
COPY igaming-aggregator/aggregator-odds-sync/src ./aggregator-odds-sync/src

# Build
RUN --mount=type=cache,target=/root/.m2 \
    mkdir -p /root/.m2/repository/pro/datawiki && \
    cp -rf /tmp/dto-repo/pro/datawiki/* /root/.m2/repository/pro/datawiki/ && \
    mvn clean package -pl aggregator-domain,aggregator-odds-sync -am -DskipTests -B

# ---------- runtime ----------
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /app/aggregator-odds-sync/target/*.jar odds-sync.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "odds-sync.jar"]
